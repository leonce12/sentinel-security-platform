# Copy to .env and replace every placeholder. Never commit .env.

# PostgreSQL (used by docker-compose)
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The application refuses to start while this still contains a placeholder.
SENTINEL_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Used when running the backend outside Docker
SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:replace-with-a-long-random-password@localhost:5432/sentinel
# Optional lightweight development database instead of PostgreSQL:
# SENTINEL_DATABASE_URL=sqlite:///./sentinel-dev.db

SENTINEL_ENVIRONMENT=development
# Set to true when Sentinel is served over HTTPS (required for real deployments)
SENTINEL_COOKIE_SECURE=false
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
SENTINEL_MAX_UPLOAD_MB=10

# ---- Optional services (Sentinel works fully without them) ----
# VirusTotal IP reputation. Lookups also have to be enabled in Settings.
SENTINEL_VIRUSTOTAL_API_KEY=

# AI analyst: none | openai_compatible | anthropic. AI also has to be enabled in Settings.
SENTINEL_AI_PROVIDER=none
SENTINEL_AI_API_KEY=
# For openai_compatible, e.g. https://api.openai.com/v1 or a local http://localhost:11434/v1 (Ollama)
SENTINEL_AI_BASE_URL=
SENTINEL_AI_MODEL=
